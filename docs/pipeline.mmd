---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	subagent(subagent)
	solo(solo)
	check(check)
	synthesize(synthesize)
	measure(measure)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	check -.-> subagent;
	check -.-> synthesize;
	plan -.-> solo;
	plan -.-> subagent;
	solo --> synthesize;
	subagent --> check;
	synthesize --> measure;
	measure --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

